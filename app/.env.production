# Direct access that skips Cloudflare (server/src/direct.rs): the desktop app falls back to it when the main
# address is unreachable (some ISPs block Cloudflare's shared IPs), and invite links on either address work.
VITE_DIRECT_SERVER=https://direct.example.com:8443
# Where this server used to be (1.x's address): invite and message links to it in old messages are still recognized.
VITE_FORMER_SERVERS=https://old.example.com
