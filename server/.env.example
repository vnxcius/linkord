LINKORD_BIND=127.0.0.1:7700
# Externally reachable URL. Discord's redirect URI must be <this>/api/auth/discord/callback
LINKORD_PUBLIC_URL=http://localhost:7700
DATABASE_URL=postgres://linkord:change-me@127.0.0.1:5433/linkord
LINKORD_DATA_DIR=./data
LINKORD_WEB_DIR=../app/dist
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Passwordless username login for local testing only. Never enable on a public server.
LINKORD_DEV_LOGIN=false
# Upload space per user in MB (default 2048)
LINKORD_UPLOAD_QUOTA_MB=2048
