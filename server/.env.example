# Linkord server settings. Copy to server/.env and fill in. Empty values count as unset.

# ---- Basics ----
# Address the server listens on (Caddy / the Cloudflare tunnel forwards here).
LINKORD_BIND=127.0.0.1:7700
# Externally reachable URL. Discord's redirect URI must be <this>/api/auth/discord/callback
LINKORD_PUBLIC_URL=http://localhost:7700
DATABASE_URL=postgres://linkord:change-me@127.0.0.1:5433/linkord
# Uploads, logs (data/logs, 30 days), desktop updates, ACME certificates, yt-dlp, the detectable games cache.
LINKORD_DATA_DIR=./data
# The built web client (app/dist).
LINKORD_WEB_DIR=../app/dist
# Default nameplates everyone can pick (WebM/PNG/GIF/WebP files). Fill it with server/scripts/fetch-nameplates.mjs.
LINKORD_NAMEPLATES_DIR=./nameplates
# Default soundboard sounds (mp3/ogg/wav/webm/m4a). A leading emoji in a file name is the sound's emoji: "🦆 quack.mp3".
LINKORD_SOUNDS_DIR=./soundboard
# Upload space per user in MB (default 2048)
LINKORD_UPLOAD_QUOTA_MB=2048

# ---- Admins ----
# Who can change the music bot's picture: Discord usernames, user ids or Discord ids, comma-separated.
LINKORD_ADMINS=

# ---- Discord login (the only way to sign in) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Passwordless username login for local testing only. Never enable on a public server.
LINKORD_DEV_LOGIN=false

# ---- Spotify (Settings -> Connections, "Listening to"). Both empty = the option is hidden. ----
# Redirect URI: <public url>/api/connections/spotify/callback (and the direct address's, if used).
# The music bot plays Spotify links without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# How often a connected account's current song is checked, in ms (default 5000).
SPOTIFY_POLL_MS=5000
# Only for tests (a fake Spotify): where the accounts and Web API live.
SPOTIFY_ACCOUNTS_URL=https://accounts.spotify.com
SPOTIFY_API_URL=https://api.spotify.com

# ---- "Playing" activities ----
# Discord's list of detectable games, fetched daily.
LINKORD_DETECTABLE_URL=https://discord.com/api/v9/applications/detectable

# ---- Music bot (Kass) ----
# yt-dlp to use (default: data/bin/yt-dlp if present, else yt-dlp on the PATH). Updated daily with -U.
LINKORD_YTDLP=
# Extra arguments for every yt-dlp call, e.g. "--js-runtimes node".
LINKORD_YTDLP_ARGS=

# ---- Direct access that skips Cloudflare (server/src/direct.rs) ----
# Second listener with its own Let's Encrypt certificate (DNS-01 through Cloudflare's API). Off when unset.
LINKORD_DIRECT_BIND=
# DNS-only hostname pointing at this machine, e.g. mc.example.com
LINKORD_DIRECT_HOST=
# "off" serves plain HTTP (tests only).
LINKORD_DIRECT_TLS=
# Cloudflare API token with "Edit zone DNS" on the domain (for the certificate).
CLOUDFLARE_API_TOKEN=
# true = Let's Encrypt staging (untrusted test certificates, no rate limits).
LINKORD_ACME_STAGING=false

# ---- Monitor (monitor/, a separate service) ----
# Loopback address for its counters and moderation requests, protected by the token in data/internal-token. "off" = none.
LINKORD_INTERNAL_BIND=127.0.0.1:7711

# ---- Logging ----
# Console (journalctl) log filter; the daily files in data/logs (read by the monitor) always keep info and above.
RUST_LOG=linkord_server=info,tower_http=warn

# Who can create an account with Discord: invite (came through a valid invite link, the default), open, or closed.
# Existing accounts can always sign in.
# LINKORD_SIGNUP=invite
