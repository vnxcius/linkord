<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose: the desk colour, so nothing flashes white or black before the first frame. -->
    <style name="Theme.Linkord" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/desk</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Linkord.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/desk</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Linkord</item>
    </style>
    <color name="desk">#E3E7ED</color>
</resources>
