# Linkord monitor settings. Copy to monitor/.env (deploy/install-monitor.sh does it and generates the password).
# Everything else (database, data directory, addresses) is read from ../server/.env, so it stays in one place.

# Required. The dashboard's own login: it works when Discord or the app are down.
LINKORD_MONITOR_PASSWORD=

# Where the dashboard listens. Keep it on loopback and reach it through an SSH tunnel:
#   ssh -L 7710:127.0.0.1:7710 <user>@<server>   then open http://localhost:7710
# Or set 0.0.0.0:7710 for your home network only. Don't forward this port on the router.
LINKORD_MONITOR_BIND=127.0.0.1:7710

# Where the app's server keeps its .env, relative to the monitor's working directory.
LINKORD_MONITOR_SERVER_DIR=../server
# History (SQLite). 30 days of samples, about 20 MB.
LINKORD_MONITOR_DATA_DIR=./data
# The built dashboard (monitor/web/dist).
LINKORD_MONITOR_WEB_DIR=./web/dist
